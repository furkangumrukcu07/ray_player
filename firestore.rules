rules_version = '2';

// Ray TV Player — Cloud Firestore Güvenlik Kuralları
service cloud.firestore {
  match /databases/{database}/documents {

    // 👤 KULLANICI PROFİLLERİ & BULUT YEDEKLEME
    // Kullanıcı kendi profilini okuyup yazabilir. Yönetici (Admin) tüm kullanıcıları listeleyebilir ve yönetebilir.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAppAdmin();
      allow write: if isOwner(userId) || isAppAdmin();

      match /{document=**} {
        allow read: if isOwner(userId) || isAppAdmin();
        allow write: if isOwner(userId) || isAppAdmin();
      }
    }

    // 🟢 ÇEVRİMİÇİ KULLANICI (PRESENCE / CANLI KALP ATIŞI)
    // Uygulamadaki tüm oturumlar (Google & Anonim) çevrimiçi durumunu yazabilir.
    match /presence/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(userId) || isAppAdmin() || request.auth != null;
      allow delete: if isOwner(userId) || isAppAdmin();
    }

    // 💳 SİPARİŞLER & SATIN ALIMLAR
    // Kullanıcı kendi siparişini görebilir, Admin tüm siparişleri görebilir ve yönetebilir.
    match /orders/{orderId} {
      allow read: if isAppAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create, update: if request.auth != null || isAppAdmin();
      allow delete: if isAppAdmin();
    }

    // ⚠️ HATA & ÇÖKME RAPORLARI
    // Tüm kullanıcılar otomatik hata logu yazabilir, yalnızca Admin okuyabilir.
    match /app_crashes/{crashId} {
      allow create: if true;
      allow read, delete: if isAppAdmin();
      allow update: if false;
    }

    // 🔑 LİSANS AKTİVASYON KODLARI
    // Yalnızca Admin oluşturabilir, düzenleyebilir ve silebilir.
    match /license_codes/{codeId} {
      allow read, write: if isAppAdmin();
    }

    // 📢 DUYURULAR & BİLDİRİMLER
    // Kullanıcılar okuyabilir, yalnızca Admin yayınlayabilir.
    match /notifications/{notifId} {
      allow read: if request.auth != null;
      allow write: if isAppAdmin();
    }

    // 💬 KULLANICIYA ÖZEL YÖNETİCİ MESAJLARI
    match /user_messages/{messageId} {
      allow read: if isAppAdmin() || (request.auth != null && resource.data.targetUid == request.auth.uid);
      allow create, update, delete: if isAppAdmin();
    }

    // 📊 YÖNETİCİ İSTATİSTİKLERİ & TELEMETRİ
    match /admin_stats/{statId} {
      allow read, write: if true;
    }

    // 🛠️ GENEL AYARLAR & UYGULAMA YAPILANDIRMASI
    match /admin_settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAppAdmin();
    }

    match /{document=**} {
      allow read, write: if isAppAdmin();
    }
  }
}

// 🔐 Yardımcı Güvenlik Fonksiyonları
function isAppAdmin() {
  return request.auth != null && (
    request.auth.uid in ['S90HID84FieYC4UBQ6BdoFrYtff2'] ||
    request.auth.token.email in ['furkangumrukcu07@gmail.com']
  );
}

function isOwner(userId) {
  return request.auth != null && (request.auth.uid == userId || isAppAdmin());
}
